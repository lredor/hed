root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{java,xml,xml.example}]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{ts,tsx,css}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
