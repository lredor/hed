<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>hed</groupId>
        <artifactId>home-electrical-designer</artifactId>
        <version>0.2.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>hed-coverage</artifactId>
    <packaging>pom</packaging>
    <name>HED Java coverage</name>
    <properties>
        <hed.root.directory>${project.basedir}/../..</hed.root.directory>
    </properties>
    <!-- Explicit reactor dependencies collect test execution data across modules. -->
    <dependencies>
        <dependency>
            <groupId>hed</groupId>
            <artifactId>hed-model</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>hed</groupId>
            <artifactId>hed-model-edit</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>hed</groupId>
            <artifactId>hed-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>hed</groupId>
            <artifactId>hed-application</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>aggregate-java-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <configuration>
                            <title>HED Java coverage</title>
                            <formats>
                                <format>HTML</format>
                                <format>XML</format>
                            </formats>
                            <dataFileIncludes>
                                <!-- Patterns are relative to each module's base directory. -->
                                <dataFileInclude>target/jacoco.exec</dataFileInclude>
                            </dataFileIncludes>
                            <excludes>
                                <!-- EMF-generated model and item providers. Tests still run. -->
                                <exclude>hed/homeelectrical/**</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
